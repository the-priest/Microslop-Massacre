; Engine configuration file.
; MICROSLOP MASSACRE — an open-world RPG. Mr. Robot's story, New Vegas' bones, and a grudge against every corporation that ever sold a gamer a loot box.
; Godot 4.7, GL Compatibility renderer (runs on integrated GPUs).

config_version=5

[application]

config/name="MICROSLOP MASSACRE"
config/description="Open-world first-person RPG: fsociety against E Corp and the game megacorps it owns. Fan project and parody: original script."
config/version="2.5.0"
run/main_scene="res://ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

DB="*res://autoload/db.gd"
GameState="*res://autoload/game_state.gd"
DialogueManager="*res://autoload/dialogue_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
Settings="*res://autoload/settings.gd"
AudioManager="*res://autoload/audio_manager.gd"
SceneRouter="*res://autoload/scene_router.gd"
Pad="*res://autoload/pad.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=0
limits/opengl/max_lights_per_object=8

[shader_globals]

gfx_detail={
"type": "float",
"value": 1.0
}
night_amt={
"type": "float",
"value": 0.0
}
wet_amt={
"type": "float",
"value": 0.0
}
sky_col={
"type": "color",
"value": Color(0.3, 0.35, 0.45, 1)
}

